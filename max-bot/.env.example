MAX_BOT_TOKEN=put_new_max_bot_token_here
MAX_API_BASE=https://platform-api.max.ru

# Public HTTPS address of this backend, without a trailing slash.
# Example: https://bot.example.com
PUBLIC_BASE_URL=

# Optional, but recommended. Use any long random value.
MAX_WEBHOOK_SECRET=

# Your personal MAX user id. You can fill it manually, or register it
# by sending "/operator YOUR_SETUP_CODE" to the bot.
OPERATOR_USER_ID=
OPERATOR_SETUP_CODE=change_this_setup_code

# Comma-separated list of website origins allowed to send leads.
# For local tests you can keep http://localhost:8000.
SITE_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

PORT=3000
HOST=127.0.0.1
